# Salin ke .env lalu isi nilai lokal. JANGAN commit .env.

# Database SQLite lokal (path relatif terhadap folder prisma/)
DATABASE_URL="file:./dev.db"

# Secret JWT untuk signing token — ganti dengan string acak panjang di .env lokal
JWT_SECRET="dev-only-secret-ganti-ini"
JWT_EXPIRES_IN="7d"

# Mode penyedia jadwal & tiket: mock | real
PROVIDER_MODE=mock

# Batas waktu tahan kursi (menit)
SEAT_HOLD_MINUTES=10

# Port HTTP API
PORT=3000
